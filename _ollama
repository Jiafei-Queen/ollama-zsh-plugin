#compdef ollama

SCRIPT_DIR="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/ollama"
_ollama_probe_running="$SCRIPT_DIR/ollama_probe_running.sh"
_ollama_list_models="$SCRIPT_DIR/ollama_list_models.sh"

_ollama_complete_models() {
  if (( CURRENT == 2 )); then
    local -a models
    models=(${(f)"$(/bin/sh "$1" 2>/dev/null)"})
    (( ${#models} )) && compadd -a models
  fi
}

_ollama() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a commands
  commands=(
    'serve:Start ollama'
    'create:Create a model from a Modelfile'
    'show:Show information for a model'
    'run:Run a model'
    'stop:Stop a running model'
    'pull:Pull a model from a registry'
    'push:Push a model to a registry'
    'list:List models'
    'ps:List running models'
    'cp:Copy a model'
    'rm:Remove a model'
    'help:Help about any command'
  )
  _arguments -C \
    '1: :->command' \
    '*:: :->args'
  case $state in
    (command)
      _describe -t commands 'ollama commands' commands
      ;;
    (args)
      case $line[1] in
        (run|show|rm|cp)
          _ollama_complete_models "$_ollama_list_models"
          ;;
        (stop)
          if (( CURRENT == 2 )); then
            local -a running_models display
            running_models=(${(f)"$(/bin/sh "$_ollama_probe_running" 2>/dev/null)"})
            display=('Stop all running models')
            compadd -d display all $running_models
          fi
          ;;
        (create)
          _arguments '-f[Specify Modelfile]:filename:_files'
          ;;
        (push)
          _arguments '1:model name' '2:destination'
          ;;
        (list|ps|serve|pull)
          ;;
        (help)
          _describe -t commands 'ollama commands' commands
          ;;
      esac
      ;;
  esac
}

_ollama "$@"
